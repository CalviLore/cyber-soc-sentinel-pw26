# Copia questo file in .env e inserisci la chiave vera. .env non va mai committato.
# Famiglia scelta: Google. Cloud = Gemini, locale = Gemma (stesso produttore).
# Entrambi usano l'endpoint compatibile col formato OpenAI (/chat/completions
# con tool calling), quindi basta base_url + chiave + modello.

# --- Cloud: Gemini (chiave da Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Un modello Flash (il piano gratuito copre solo quelli; controllare il nome
# esatto e i limiti in AI Studio).
GEMINI_MODEL=

# --- Locale: Gemma su Ollama (nessuna chiave) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
# Modello ufficiale dalla libreria Ollama (4.6 GB: già oltre i 4 GB di VRAM
# del PC di sviluppo, quindi niente taglie più grandi).
OLLAMA_MODEL_GOOGLE=gemma4:e2b

# --- Alternativa messa a confronto: Mistral (chiave da console.mistral.ai) ---
# Cloud: Mistral API. Locale: Ministral, sempre su Ollama.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Modello da scegliere dal catalogo Mistral (con tool calling).
MISTRAL_MODEL=
OLLAMA_MODEL_MISTRAL=ministral-3:3b
