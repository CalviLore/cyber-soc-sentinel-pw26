# Copia questo file in .env e inserisci le chiavi vere. .env non va mai committato.
# Famiglie in prova: Google (Gemini + Gemma) e Mistral. Cloud e locale dello stesso
# produttore. Tutti usano l'endpoint compatibile col formato OpenAI
# (/chat/completions con tool calling), quindi basta base_url + chiave + modello.
# Nomi dei modelli verificati il 2026-11-03; per elencare quelli della propria chiave:
#   python tools/elenca_modelli.py

# --- Cloud: Google (chiave da https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Il Flash più nuovo che risponde sul piano gratuito (i Pro sono bloccati).
GEMINI_MODEL=gemini-3.6-flash
# Usato solo se il modello principale non risponde (errori 429/5xx, timeout).
GEMINI_FALLBACK_MODEL=gemma-4-31b-it

# --- Cloud: Mistral (chiave da https://console.mistral.ai/api-keys) ---
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Modello di punta sul piano gratuito: limite osservato 20.000 token/minuto.
MISTRAL_MODEL=mistral-large-4

# --- Cloud: NVIDIA NIM (chiave da https://build.nvidia.com, piano gratuito per prototipi) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Modello di punta della famiglia Nemotron; per elencare quelli del proprio account:
#   python tools/elenca_modelli.py nvidia nemotron
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Locale: Ollama (nessuna chiave) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
# Versioni ufficiali dalla libreria Ollama (quantizzazione Q4_K_M)...
OLLAMA_MODEL_GOOGLE=gemma4:e4b
OLLAMA_MODEL_MISTRAL=ministral-3:8b
# ...e quantizzazioni Unsloth dello stesso modello (UD-Q3_K_XL), per confronto.
OLLAMA_MODEL_GOOGLE_UNSLOTH=hf.co/unsloth/gemma-4-E4B-it-GGUF:UD-Q3_K_XL
OLLAMA_MODEL_MISTRAL_UNSLOTH=hf.co/unsloth/Ministral-3-8B-Instruct-2512-GGUF:UD-Q3_K_XL
